# Email Configuration for Contact Form
# Get your Gmail App Password here: https://myaccount.google.com/apppasswords

EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Instructions:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail" and "Windows Computer"
# 4. Copy the 16-character password and paste it as EMAIL_PASSWORD
# 5. Rename this file to .env and fill in your actual credentials
